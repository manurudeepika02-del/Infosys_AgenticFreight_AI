# FreightQuote AI — environment variable names only.
# Copy this file to .env and fill in YOUR OWN real values.
# NEVER commit a .env file with real values — see README Section 6.

# Hugging Face access token to download Qwen2.5 model weights
# Get it from: huggingface.co -> Settings -> Access Tokens
HF_TOKEN=

# Kaggle API credentials (only needed if a dataset is pulled via the Kaggle API)
# Get them from: kaggle.com -> Account -> Create New API Token
KAGGLE_USERNAME=
KAGGLE_KEY=

# Sending mailbox for OTP emails — use a dedicated project/team mailbox, not a personal one
OTP_EMAIL_ADDRESS=

# Gmail App Password (NOT the real account password) for SMTP send
# Get it from: Google Account -> Security -> App Passwords (requires 2FA enabled)
OTP_EMAIL_APP_PASSWORD=

# Signing key for session tokens
# Generate locally with: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET_KEY=
